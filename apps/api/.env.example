# AuraShare Backend - Environment Variables Configuration
# Copy this file to '.env' and fill in your actual credentials.

PROJECT_NAME="AuraShare API"
SECRET_KEY="YOUR_SUPER_SECRET_JWT_KEY"

# Database (Leave as is for local SQLite)
DATABASE_URL="sqlite:///./aurashare.db"

# ==========================================
# ☁️ CLOUDFLARE R2 (For Live public Image URLs)
# ==========================================
# 1. Sign up on Cloudflare and create an R2 Bucket (e.g. 'aurashare-production')
# 2. Get your Account ID from the Cloudflare Dashboard URL or R2 page.
# 3. Create an API token with 'Edit' permissions for R2 to get Access Key ID and Secret Access Key.
# 4. Connect a custom domain or use the Cloudflare-provided public URL prefix.

R2_ACCOUNT_ID="your_real_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_real_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_real_r2_secret_access_key"
R2_BUCKET_NAME="aurashare-production"
R2_PUBLIC_URL_PREFIX="https://your-r2-public-subdomain.r2.dev" # Or custom domain like 'https://i.aurashare.com'

# ==========================================
# 🤖 OPENAI (For AI Chat & Image Generation)
# ==========================================
# Create an API Key at https://platform.openai.com/
OPENAI_API_KEY="sk-proj-your-real-openai-api-key"
